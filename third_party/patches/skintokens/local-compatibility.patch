+def transfer_weights_to_existing_skeleton(source_asset: Asset, target_path: PathLike,
+                                         export_path: PathLike) -> None:
+    """Reweight an existing single-skeleton GLB without recreating its bind rig.
+
+    Geometry, joint nodes, bone axes, inverse binds, and existing animation data
+    remain unchanged. Model columns are matched by joint name after its ordering
+    transform, then normalized/top-four packed in the original skin's order.
+    """
+    from pygltflib import GLTF2
+
+    g = GLTF2().load_binary(str(target_path))
+    active = {n.skin for n in g.nodes if n.mesh is not None and n.skin is not None}
+    if not active or len({tuple(g.skins[i].joints) for i in active}) != 1:
+        raise ValueError("Existing-skeleton skinning requires one active skeleton; split multi-rig scenes into separate assets")
+    skin_index = next(iter(active))
+    names = [g.nodes[i].name for i in g.skins[skin_index].joints]
+    source_names = list(source_asset.joint_names or [])
+    if len(set(names)) != len(names) or len(set(source_names)) != len(source_names):
+        raise ValueError("Existing-skeleton skinning requires unique joint names")
+    if set(names) != set(source_names):
+        raise ValueError("Predicted skeleton names differ from the supplied skeleton; refusing to change the bind rig")
+    columns = np.asarray([source_names.index(name) for name in names], dtype=np.int64)
+    blob = bytearray(g.binary_blob() or b'')
+    parent_of = _node_parents(g)
+    cache = {}
+    parts = []
+    for node_i, node in enumerate(g.nodes):
+        if node.mesh is None:
+            continue
+        m = _world_matrix(g, parent_of, node_i, cache)
+        for prim in g.meshes[node.mesh].primitives:
+            world = rest_world_vertices(g, blob, node_i, prim, parent_of, cache)
+            parts.append((node.skin, prim, world))
+    target_vertices = np.vstack([v for _, _, v in parts])
+    source_vertices = np.asarray(source_asset.vertices, dtype=np.float64)
+    transform = estimate_similarity_transform(source_vertices, target_vertices)
+    aligned = source_vertices @ transform[:3, :3].T + transform[:3, 3]
+    source_weights = np.asarray(source_asset.skin)[:, columns]
+    for node_skin, prim, world in parts:
+        if node_skin is None:
+            continue  # unbound props remain unbound; attaching props is a separate operation
+        dense = _skin_for_targets(aligned, source_weights, world)
+        joints, weights = pack_top4(dense)
+        prim.attributes.JOINTS_0 = _accessor(g, blob, joints, _UNSIGNED_SHORT, 'VEC4', 34962)
+        prim.attributes.WEIGHTS_0 = _accessor(g, blob, weights, _FLOAT, 'VEC4', 34962)
+        # More-than-four original influence sets must not remain active.
+        for attribute in list(vars(prim.attributes)):
+            if attribute.startswith(('JOINTS_', 'WEIGHTS_')) and attribute not in ('JOINTS_0', 'WEIGHTS_0'):
+                setattr(prim.attributes, attribute, None)
+    while len(blob) % 4:
+        blob.append(0)
+    g.buffers[0].byteLength = len(blob)
+    g.set_binary_blob(bytes(blob))
+    g.save_binary(str(export_path))
+
