+def rest_world_vertices(g, blob, node_i, prim, parent_of=None, cache=None):
+    """Actual glTF bind/rest geometry, including skin inverse binds and joint scales."""
+    parent_of = _node_parents(g) if parent_of is None else parent_of
+    cache = {} if cache is None else cache
+    node = g.nodes[node_i]
+    v = _read_accessor(g, blob, prim.attributes.POSITION).astype(np.float64)
+    if node.skin is None or prim.attributes.JOINTS_0 is None:
+        m = _world_matrix(g, parent_of, node_i, cache)
+        return v @ m[:3, :3].T + m[:3, 3]
+    skin = g.skins[node.skin]
+    ibm = (_read_accessor(g, blob, skin.inverseBindMatrices).reshape(-1,4,4).transpose(0,2,1)
+           if skin.inverseBindMatrices is not None else np.tile(np.eye(4),(len(skin.joints),1,1)))
+    palette = np.stack([_world_matrix(g,parent_of,i,cache) for i in skin.joints]) @ ibm
+    vh = np.c_[v,np.ones(len(v))]
+    result = np.zeros((len(v),4));sums=np.zeros(len(v))
+    sets = sorted(k for k,val in vars(prim.attributes).items() if k.startswith('WEIGHTS_') and val is not None)
+    for key in sets:
+        weights = _read_accessor(g,blob,getattr(prim.attributes,key)).astype(np.float64)
+        joints = _read_accessor(g,blob,getattr(prim.attributes,key.replace('WEIGHTS_','JOINTS_'))).astype(np.int64)
+        for k in range(weights.shape[1]):
+            result += weights[:,k,None] * np.einsum('nij,nj->ni',palette[joints[:,k]],vh)
+        sums += weights.sum(1)
+    if (sums < 1e-8).any():
+        raise ValueError('Input bind rig contains unweighted vertices; repair it before reweighting')
+    return result[:,:3] / sums[:,None]
+
+
+def load_rest_asset(path, cls='articulation'):
+    """Build model input in bind/world space; trimesh alone does not evaluate glTF skins."""
+    from pygltflib import GLTF2
+    g=GLTF2().load_binary(str(path));blob=g.binary_blob();parent_of=_node_parents(g);cache={}
+    vertices=[];faces=[];names=[];offset=0
+    for i,node in enumerate(g.nodes):
+        if node.mesh is None:continue
+        for prim in g.meshes[node.mesh].primitives:
+            if prim.mode not in (None,4):raise ValueError('Triangulate input primitives before existing-skeleton skinning')
+            v=rest_world_vertices(g,blob,i,prim,parent_of,cache)
+            idx=_read_accessor(g,blob,prim.indices).reshape(-1) if prim.indices is not None else np.arange(len(v))
+            vertices.append(v);faces.append(idx.reshape(-1,3)+offset);names.append(node.name or str(i));offset+=len(v)
+    a=Asset(vertices=np.vstack(vertices).astype(np.float32),faces=np.vstack(faces).astype(np.int64),mesh_names=names,cls=cls,path=str(path))
+    a.build_normals()
+    return a
+
